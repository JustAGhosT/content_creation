// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// JSON payloads remain serialized strings for backward compatibility with the
// existing application contracts. A later, separately reviewed migration can
// promote individual columns to PostgreSQL jsonb.
//
// Use `prisma migrate dev` for local schema development and committed
// `prisma migrate deploy` migrations in CI/production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User model for authentication
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String // bcrypt hashed password
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  campaigns          Campaign[]
  auditLogs          AuditLog[]
  platformAccounts   PlatformAccount[]
  externalIdentities ExternalIdentity[]
  schedulerJobs      SchedulerJob[]
  analyticsEvents    AnalyticsEventRecord[]
}

// Durable mapping from an external provider subject to its local tenant owner.
// Email is deliberately not used as an identity key because an unverified
// provider claim must never silently take over an existing local account.
model ExternalIdentity {
  id         String   @id @default(cuid())
  provider   String
  externalId String
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId])
}

// Tenant-owned provider credentials. Token values are encrypted by the
// application before they reach PostgreSQL and are never returned by APIs.
model PlatformAccount {
  id                    String    @id @default(cuid())
  userId                String
  platform              String
  providerAccountId     String
  providerUsername      String?
  encryptedAccessToken  String
  encryptedRefreshToken String?
  tokenType             String    @default("bearer")
  scopes                String
  expiresAt             DateTime?
  status                String    @default("connected")
  connectedAt           DateTime  @default(now())
  refreshedAt           DateTime?
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@unique([platform, providerAccountId])
  @@index([userId, status])
  @@index([platform, status])
}

// Campaign model for content campaigns
model Campaign {
  id             String    @id @default(cuid())
  externalId     String?
  slug           String?
  name           String
  description    String?
  status         String    @default("draft") // draft, scheduled, active, paused, completed
  currentVersion Int       @default(1)
  source         String    @default("user") // user, git-import
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contents         Content[]
  posts            ScheduledPost[]
  versions         CampaignVersion[]
  attributionLinks AttributionLink[]
  publishAttempts  PublishAttempt[]
  decisions        CampaignDecision[]

  // Series relation
  seriesId String?
  series   Series? @relation(fields: [seriesId], references: [id])

  @@unique([userId, externalId])
  @@unique([userId, slug])
  @@index([userId])
  @@index([status])
}

// Immutable campaign snapshots. Editing an approved campaign creates a new row/version.
model CampaignVersion {
  id           String   @id @default(cuid())
  campaignId   String
  version      Int
  snapshot     String // Canonical JSON snapshot
  snapshotHash String // sha256:<hex>
  createdBy    String
  createdAt    DateTime @default(now())

  campaign            Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  approvals           CampaignApproval[]
  attributionLinks    AttributionLink[]
  aiGenerationRecords AiGenerationRecord[]
  publishAttempts     PublishAttempt[]
  decisions           CampaignDecision[]
  scheduledPosts      ScheduledPost[]
  schedulerJobs       SchedulerJob[]

  @@unique([campaignId, version])
  @@unique([campaignId, snapshotHash])
  @@index([campaignId, createdAt])
}

// Approval rows are append-only and bind a reviewer to an exact version/content hash.
model CampaignApproval {
  id                String   @id @default(cuid())
  campaignVersionId String
  contentId         String
  variantId         String?
  state             String // approved, rejected
  reviewerId        String
  reviewedAt        DateTime @default(now())
  contentHash       String
  notes             String?

  campaignVersion CampaignVersion @relation(fields: [campaignVersionId], references: [id], onDelete: Cascade)

  @@index([campaignVersionId, contentId])
  @@index([reviewerId, reviewedAt])
}

model AttributionLink {
  id                String   @id @default(cuid())
  campaignId        String
  campaignVersionId String
  contentId         String
  variantId         String
  platformId        String
  trackingToken     String   @unique
  utmId             String
  utmSource         String
  utmMedium         String
  utmCampaign       String
  utmContent        String
  createdAt         DateTime @default(now())

  campaign        Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignVersion CampaignVersion @relation(fields: [campaignVersionId], references: [id], onDelete: Cascade)

  @@unique([campaignVersionId, variantId])
  @@index([campaignId])
}

model AiGenerationRecord {
  id                String   @id @default(cuid())
  campaignVersionId String
  contentId         String
  variantId         String
  evidence          String // Schema-valid JSON evidence
  inputHash         String
  outputHash        String
  reviewerId        String
  decision          String
  createdAt         DateTime

  campaignVersion CampaignVersion @relation(fields: [campaignVersionId], references: [id], onDelete: Cascade)

  @@index([campaignVersionId, variantId])
}

model PublishAttempt {
  id                String    @id @default(cuid())
  campaignId        String
  campaignVersionId String
  contentId         String
  variantId         String
  platformId        String
  contentHash       String
  status            String    @default("requested")
  providerPostId    String?
  providerPostUrl   String?
  auditEventId      String?
  errorCode         String?
  requestedBy       String
  schedulerJobId    String?   @unique
  requestedAt       DateTime  @default(now())
  completedAt       DateTime?

  campaign        Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignVersion CampaignVersion @relation(fields: [campaignVersionId], references: [id], onDelete: Cascade)
  schedulerJob    SchedulerJob?   @relation(fields: [schedulerJobId], references: [id], onDelete: SetNull)

  @@index([campaignId, requestedAt])
  @@index([campaignVersionId, variantId])
}

model CampaignDecision {
  id                String   @id @default(cuid())
  campaignId        String
  campaignVersionId String
  decision          String
  rationale         String
  evidence          String?
  decidedBy         String
  decidedAt         DateTime @default(now())

  campaign        Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignVersion CampaignVersion @relation(fields: [campaignVersionId], references: [id], onDelete: Cascade)

  @@index([campaignId, decidedAt])
}

// Content model for campaign content items
model Content {
  id          String   @id @default(cuid())
  title       String
  body        String
  contentType String   @default("post") // post, article, thread
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  campaignId  String
  campaign    Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adaptations PlatformAdaptation[]

  @@index([campaignId])
}

// Platform adaptation for content
model PlatformAdaptation {
  id             String    @id @default(cuid())
  platformId     String // linkedin, twitter, etc.
  adaptedContent String
  status         String    @default("pending") // pending, scheduled, published, failed
  publishedUrl   String?
  publishedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([platformId])
}

// Scheduled post model
model ScheduledPost {
  id                  String    @id @default(cuid())
  platformId          String
  scheduledAt         DateTime
  status              String    @default("scheduled") // scheduled, processing, published, failed, cancelled
  publishedAt         DateTime?
  error               String?
  retryCount          Int       @default(0)
  campaignVersionId   String?
  approvedContentHash String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  campaignId      String
  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignVersion CampaignVersion? @relation(fields: [campaignVersionId], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([campaignVersionId])
  @@index([status])
  @@index([scheduledAt])
}

// Tenant-owned durable publish queue. A processing lease is never retried
// automatically after expiry because the provider result may be unknown;
// reconciliation must establish the provider outcome first.
model SchedulerJob {
  id                  String    @id @default(cuid())
  userId              String
  idempotencyKey      String
  requestFingerprint  String
  type                String
  campaignId          String?
  campaignVersion     Int?
  campaignVersionId   String?
  approvedContentHash String?
  variantId           String?
  contentId           String
  platformId          String
  content             String
  scheduledAt         DateTime
  timezone            String
  status              String    @default("scheduled")
  attempts            Int       @default(0)
  maxAttempts         Int       @default(5)
  lastAttemptAt       DateTime?
  nextRetryAt         DateTime?
  leaseToken          String?
  leaseExpiresAt      DateTime?
  attemptStartedAt    DateTime?
  publishedAt         DateTime?
  publishedUrl        String?
  platformPostId      String?
  errorCode           String?
  error               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignVersionRow CampaignVersion? @relation(fields: [campaignVersionId], references: [id], onDelete: SetNull)
  publishAttempt     PublishAttempt?

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([status, scheduledAt])
  @@index([status, nextRetryAt])
  @@index([leaseExpiresAt])
  @@index([campaignId])
  @@index([campaignVersionId])
}

// Shared scheduler dispatch quota. PostgreSQL transactions serialize reservations
// per platform so overlapping workers cannot each consume a process-local limit.
model SchedulerPlatformQuota {
  platformId     String    @id
  windowStart    DateTime
  windowDuration Int
  requestCount   Int       @default(0)
  requestLimit   Int
  dailyCount     Int?
  dailyLimit     Int?
  dailyResetAt   DateTime?
  backoffUntil   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Privacy-safe, durable product and campaign telemetry. Properties are stored
// only after event-specific allow-list validation; raw content, credentials,
// email addresses, IP addresses, and authorization material are rejected.
model AnalyticsEventRecord {
  id               String   @id @default(cuid())
  eventId          String   @unique
  name             String
  userId           String?
  campaignId       String?
  campaignVersion  Int?
  contentId        String?
  variantId        String?
  platform         String?
  publishAttemptId String?
  providerPostId   String?
  campaignToken    String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  landingPage      String?
  properties       String
  occurredAt       DateTime
  receivedAt       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([userId, campaignId, occurredAt])
  @@index([campaignToken, occurredAt])
  @@index([name, occurredAt])
}

// Series model for content series
model Series {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  campaigns Campaign[]
}

// Lead model for lead management
model Lead {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String?
  lastName  String?
  company   String?
  phone     String?
  source    String?
  status    String   @default("new") // new, contacted, qualified, converted, lost
  score     Int      @default(0)
  tags      String? // JSON array stored as string
  metadata  String? // JSON object stored as string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  interactions LeadInteraction[]

  @@index([email])
  @@index([status])
}

// Lead interaction model
model LeadInteraction {
  id          String   @id @default(cuid())
  type        String // email, call, meeting, note
  description String?
  metadata    String? // JSON object stored as string
  createdAt   DateTime @default(now())

  // Relations
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

// Audit log for tracking actions
// ============================================
// PII Retention Policy
// ============================================
// Fields ipAddress and userAgent contain potential PII and are subject to:
// - Retention: 90 days from createdAt (configurable via AUDIT_LOG_RETENTION_DAYS env var)
// - Anonymization: After TTL, ipAddress is hashed (SHA-256) and userAgent is truncated
// - Access Control: Only admin/compliance roles may query raw PII fields
//
// Cleanup Job: Run via scheduled task (cron: "0 3 * * *" - daily at 3 AM UTC)
// - Behavior: Records older than TTL have ipAddress hashed and userAgent set to "[ANONYMIZED]"
// - Alternative: Set AUDIT_LOG_DELETE_AFTER_TTL=true to delete instead of anonymize
// - Implementation: See lib/jobs/audit-log-cleanup.ts (or implement as API route/cron job)
// - The createdAt index supports efficient date-range queries for cleanup
// ============================================
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String? // Optional: campaign, content, lead, etc. (not required for API-only logs)
  entityId   String?
  details    String? // JSON object stored as string
  // HTTP request audit fields (used by app/api/_utils/audit.ts)
  path       String? // Request path (e.g., /api/auth)
  method     String? // HTTP method (GET, POST, etc.)
  body       String? // JSON stringified request body (sanitized)
  result     String? // Result status (success, failure, etc.)
  statusCode Int? // HTTP status code
  // PII fields (subject to retention policy above)
  ipAddress  String? // PII: subject to retention policy (see above)
  userAgent  String? // PII: subject to retention policy (see above)
  createdAt  DateTime @default(now())

  // Relations
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt]) // Used for retention policy cleanup queries
}

// Notification model
model Notification {
  id        String    @id @default(cuid())
  type      String // email, slack, sms
  recipient String
  subject   String?
  message   String
  status    String    @default("pending") // pending, sent, failed
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())

  @@index([type])
  @@index([status])
}

// Form model for form builder
model Form {
  id          String   @id @default(cuid())
  name        String
  description String?
  fields      String // JSON array stored as string
  settings    String? // JSON object stored as string
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  submissions FormSubmission[]

  @@index([isActive])
}

// Video generation job model (AI Video Pipeline)
// Tracks Runway Act-Two video generation tasks
model VideoJob {
  id              String   @id @default(cuid())
  taskId          String   @unique // Runway task ID
  status          String   @default("PENDING") // PENDING, RUNNING, SUCCEEDED, FAILED, CANCELLED
  characterPrompt String
  motionVideoUrl  String?
  outputVideoUrl  String?
  platforms       String // JSON array stored as string (e.g., '["tiktok","instagram"]')
  duration        Int      @default(5) // Video duration in seconds (5 or 10)
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Form submission model
model FormSubmission {
  id        String   @id @default(cuid())
  data      String // JSON object stored as string
  metadata  String? // JSON object stored as string
  createdAt DateTime @default(now())

  // Relations
  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}
