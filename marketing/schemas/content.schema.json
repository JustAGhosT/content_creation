{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://omnipost.app/schemas/content.schema.json",
  "title": "OmniPost canonical content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contentId",
    "version",
    "type",
    "title",
    "body",
    "owner",
    "reviewer",
    "approval",
    "claims",
    "adaptations"
  ],
  "properties": {
    "contentId": {
      "type": "string",
      "pattern": "^content_[a-z0-9_]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": ["standalone", "thread", "article", "video", "image"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "enum": ["draft", "pending", "approved", "rejected"]
        },
        "reviewedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "reviewedAt": {},
              "contentHash": {}
            },
            "required": ["reviewedAt", "contentHash"]
          }
        }
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "risk", "proof"],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "enum": ["none", "low", "medium", "high"]
          },
          "proof": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sourceAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "source", "rights"],
        "properties": {
          "assetId": {
            "type": "string",
            "pattern": "^asset_[a-z0-9_]+$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "rights": {
            "enum": ["owned", "licensed", "public-domain", "generated"]
          },
          "attribution": {
            "type": "string"
          }
        }
      }
    },
    "adaptations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variantId", "platformId", "body", "status", "attribution"],
        "properties": {
          "variantId": {
            "type": "string",
            "pattern": "^variant_[a-z0-9_]+$"
          },
          "platformId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]+$"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "status": {
            "enum": ["draft", "pending", "approved", "scheduled", "published", "failed"]
          },
          "attribution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["utmContent", "trackingToken"],
            "properties": {
              "utmContent": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
              "trackingToken": {
                "type": "string",
                "pattern": "^mtk_[a-z0-9_]+$"
              }
            }
          }
        }
      }
    }
  }
}
